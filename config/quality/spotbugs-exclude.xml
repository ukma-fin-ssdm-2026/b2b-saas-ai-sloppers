<?xml version="1.0" encoding="UTF-8"?>

<FindBugsFilter>

    <!--
      Spring-компоненти отримують залежності через конструктор, і SpotBugs вважає
      збережене посилання на bean «записом зовнішнього об'єкта в поле».
      Для інжекції залежностей це хибне спрацювання.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~ua\.edu\.ukma\.community\..*(Controller|Service)"/>
    </Match>

</FindBugsFilter>
