@startuml data-model
title Студентське ком'юніті та Івенти — ER-модель

hide circle
hide methods
skinparam linetype ortho
skinparam classAttributeIconSize 0

' Позначки: <<PK>> первинний ключ, <<FK>> зовнішній ключ,
' <<PII>> персональні дані, <<sensitive>> секрети/чутливі дані

' ===== Користувачі та доступ =====

entity "user" as user {
  * id : uuid <<PK>>
  --
  * email : varchar <<UNIQUE>> <<PII>>
  * first_name : varchar <<PII>>
  * last_name : varchar <<PII>>
  * password_hash : varchar <<sensitive>>
  * role : enum(USER, GLOBAL_ADMIN)
  * is_active : boolean
  verification_code_hash : varchar <<sensitive>>
  code_expires_at : timestamptz
  code_attempts : int
  * created_at : timestamptz
}

entity "ban" as ban {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  banned_by : uuid <<FK>>
  * reason : text <<sensitive>>
  * created_at : timestamptz
  expires_at : timestamptz
  lifted_by : uuid <<FK>>
  lifted_at : timestamptz
}

' ===== Організації =====

entity "organization" as organization {
  * id : uuid <<PK>>
  --
  * name : varchar <<UNIQUE>>
  description : text
  logo_url : varchar
  website_url : varchar
  instagram_url : varchar
  whatsapp_url : varchar
  * auto_publish : boolean
  archived_at : timestamptz
  * created_at : timestamptz
}

entity "tag" as tag {
  * id : uuid <<PK>>
  --
  * name : varchar <<UNIQUE>>
}

entity "organization_tag" as organization_tag {
  * organization_id : uuid <<PK, FK>>
  * tag_id : uuid <<PK, FK>>
}

entity "organization_head" as organization_head {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * organization_id : uuid <<FK>>
  * appointed_by : uuid <<FK>>
  * appointed_at : timestamptz
  revoked_by : uuid <<FK>>
  revoked_at : timestamptz
}

' ===== Джерела та події =====

entity "scraper_source" as source {
  * id : uuid <<PK>>
  --
  * organization_id : uuid <<FK>>
  * type : enum(INSTAGRAM)
  * url : varchar
  * enabled : boolean
  last_run_at : timestamptz
  last_run_status : enum(SUCCESS, FAILED)
  last_error : text
  * created_at : timestamptz
}

entity "event" as event {
  * id : uuid <<PK>>
  --
  * organization_id : uuid <<FK>>
  source_id : uuid <<FK>>
  external_post_id : varchar
  original_url : varchar
  * title : varchar
  description : text
  * starts_at : timestamptz
  location : varchar
  * status : enum(PENDING, PUBLISHED, REJECTED, UNPUBLISHED)
  * is_verified : boolean
  created_by : uuid <<FK>>
  reviewed_by : uuid <<FK>>
  * created_at : timestamptz
  * updated_at : timestamptz
}

' ===== Дошка оголошень =====

entity "advert" as advert {
  * id : uuid <<PK>>
  --
  * author_id : uuid <<FK>>
  * type : enum(TEAM, LEISURE)
  * title : varchar
  * description : text
  * slots : int
  * deadline : timestamptz
  * contact : varchar <<PII>>
  * status : enum(ACTIVE, CLOSED, DELETED)
  * created_at : timestamptz
}

entity "advert_response" as advert_response {
  * id : uuid <<PK>>
  --
  * advert_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  message : text <<PII>>
  * status : enum(PENDING, CONFIRMED, REJECTED, WITHDRAWN)
  * created_at : timestamptz
  decided_at : timestamptz
}

' ===== Модерація контенту =====

entity "complaint" as complaint {
  * id : uuid <<PK>>
  --
  * reporter_id : uuid <<FK>>
  advert_id : uuid <<FK>>
  response_id : uuid <<FK>>
  * reason : enum(SPAM, ABUSE, OTHER)
  comment : text
  * status : enum(OPEN, RESOLVED, DISMISSED)
  resolved_by : uuid <<FK>>
  * created_at : timestamptz
}

entity "banned_word" as banned_word {
  * id : uuid <<PK>>
  --
  * word : varchar <<UNIQUE>>
  * created_by : uuid <<FK>>
}

' ===== Рейтинги (Could) =====

entity "author_rating" as author_rating {
  * id : uuid <<PK>>
  --
  * rater_id : uuid <<FK>>
  * author_id : uuid <<FK>>
  * advert_id : uuid <<FK>>
  * score : smallint
  * created_at : timestamptz
}

entity "organization_rating" as organization_rating {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * organization_id : uuid <<FK>>
  * score : smallint
  * updated_at : timestamptz
}

' ===== Зв'язки =====

user ||--o{ ban : "отримує"
user ||--o{ organization_head : "є головою"
organization ||--|{ organization_head : "має голів"
organization ||--o{ organization_tag
tag ||--o{ organization_tag
organization ||--o{ source
organization ||--o{ event
source |o--o{ event : "спаршено з"
user |o--o{ event : "створює / перевіряє"
user ||--o{ advert : "автор"
advert ||--o{ advert_response
user ||--o{ advert_response : "відгукується"
user ||--o{ complaint : "скаржиться"
advert |o--o{ complaint
advert_response |o--o{ complaint
user ||--o{ banned_word : "веде"
user ||--o{ author_rating
advert ||--o{ author_rating
user ||--o{ organization_rating
organization ||--o{ organization_rating

note bottom of event
  UNIQUE(source_id, external_post_id) — FR-025, NFR-005
  starts_at зберігається в UTC — NFR-011
  created_by = null → подію створив скрейпер
end note

