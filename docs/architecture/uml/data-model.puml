@startuml data-model
title Студентське ком'юніті та Івенти — ER-модель

hide circle
hide methods
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor<<план>> #EEEEEE
  BorderColor<<план>> #999999
  FontColor<<план>> #666666
}

' Позначки: <<PK>> первинний ключ, <<FK>> зовнішній ключ,
' <<PII>> персональні дані, <<sensitive>> секрети/чутливі дані.
' Сутності зі стереотипом <<план>> ще не мають міграцій; поля з "(план)" — теж.
' Реалізовану схему див. infra/migrations/V1–V4.

' ===== Користувачі та доступ =====

entity "app_user" as app_user {
  * id : uuid <<PK>>
  --
  * email : varchar <<UNIQUE>> <<PII>>
  * password_hash : varchar <<sensitive>>
  * status : enum(PENDING, ACTIVE, BLOCKED)
  * global_admin : boolean
  verification_code_hash : varchar <<sensitive>>
  verification_expires_at : timestamptz
  verification_attempts : int
  verification_sent_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "ban" as ban <<план>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  banned_by : uuid <<FK>>
  * reason : text <<sensitive>>
  * created_at : timestamptz
  expires_at : timestamptz
  lifted_by : uuid <<FK>>
  lifted_at : timestamptz
}

' ===== Організації =====

entity "organization" as organization {
  * id : uuid <<PK>>
  --
  * name : varchar
  * slug : varchar <<UNIQUE>>
  description : varchar
  instagram_handle : varchar
  contact_email : varchar
  logo_url : varchar
  * auto_publish : boolean
  archived_at : timestamptz (план)
  * created_at : timestamptz
  * updated_at : timestamptz
}

entity "tag" as tag <<план>> {
  * id : uuid <<PK>>
  --
  * name : varchar <<UNIQUE>>
}

entity "organization_tag" as organization_tag <<план>> {
  * organization_id : uuid <<PK, FK>>
  * tag_id : uuid <<PK, FK>>
}

entity "organization_head" as organization_head {
  * organization_id : uuid <<PK, FK>>
  * user_id : uuid <<PK, FK>>
  --
  appointed_by : uuid <<FK>>
  * appointed_at : timestamptz
}

entity "role_change" as role_change {
  * id : uuid <<PK>>
  --
  * organization_id : uuid <<FK>>
  * target_user_id : uuid <<FK>>
  actor_user_id : uuid <<FK>>
  * action : enum(APPOINTED, REMOVED)
  * created_at : timestamptz
}

' ===== Джерела та події =====

entity "scraper_source" as scraper_source <<план>> {
  * id : uuid <<PK>>
  --
  * organization_id : uuid <<FK>>
  * type : enum(INSTAGRAM)
  * url : varchar
  * enabled : boolean
  last_run_at : timestamptz
  last_run_status : enum(SUCCESS, FAILED)
  last_error : text
  * created_at : timestamptz
}

entity "event" as event {
  * id : uuid <<PK>>
  --
  * organization_id : uuid <<FK>>
  source_id : uuid
  external_post_id : varchar
  original_url : varchar
  * title : varchar
  description : text
  * starts_at : timestamptz
  location : varchar
  image_url : varchar
  * status : enum(PENDING, PUBLISHED, REJECTED, UNPUBLISHED)
  * verified : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
}

' ===== Дошка оголошень =====

entity "advert" as advert <<план>> {
  * id : uuid <<PK>>
  --
  * author_id : uuid <<FK>>
  * type : enum(TEAM, LEISURE)
  * title : varchar
  * description : text
  * slots : int
  * deadline : timestamptz
  * contact : varchar <<PII>>
  * status : enum(ACTIVE, CLOSED, DELETED)
  * created_at : timestamptz
}

entity "advert_response" as advert_response <<план>> {
  * id : uuid <<PK>>
  --
  * advert_id : uuid <<FK>>
  * user_id : uuid <<FK>>
  message : text <<PII>>
  * status : enum(PENDING, CONFIRMED, REJECTED, WITHDRAWN)
  * created_at : timestamptz
  decided_at : timestamptz
}

' ===== Модерація контенту =====

entity "complaint" as complaint <<план>> {
  * id : uuid <<PK>>
  --
  * reporter_id : uuid <<FK>>
  advert_id : uuid <<FK>>
  response_id : uuid <<FK>>
  * reason : enum(SPAM, ABUSE, OTHER)
  comment : text
  * status : enum(OPEN, RESOLVED, DISMISSED)
  resolved_by : uuid <<FK>>
  * created_at : timestamptz
}

entity "banned_word" as banned_word <<план>> {
  * id : uuid <<PK>>
  --
  * word : varchar <<UNIQUE>>
  * created_by : uuid <<FK>>
}

' ===== Рейтинги (пріоритет Низький) =====

entity "author_rating" as author_rating <<план>> {
  * id : uuid <<PK>>
  --
  * rater_id : uuid <<FK>>
  * author_id : uuid <<FK>>
  * advert_id : uuid <<FK>>
  * score : smallint
  * created_at : timestamptz
}

entity "organization_rating" as organization_rating <<план>> {
  * id : uuid <<PK>>
  --
  * user_id : uuid <<FK>>
  * organization_id : uuid <<FK>>
  * score : smallint
  * updated_at : timestamptz
}

' ===== Зв'язки =====

app_user ||--o{ ban : "отримує"
app_user ||--o{ organization_head : "є головою"
organization ||--|{ organization_head : "має голів"
organization ||--o{ role_change : "журнал ролей"
app_user ||--o{ role_change : "кому / хто"
organization ||--o{ organization_tag
tag ||--o{ organization_tag
organization ||--o{ scraper_source
organization ||--o{ event
scraper_source |o..o{ event : "спаршено з (FK — план)"
app_user ||--o{ advert : "автор"
advert ||--o{ advert_response
app_user ||--o{ advert_response : "відгукується"
app_user ||--o{ complaint : "скаржиться"
advert |o--o{ complaint
advert_response |o--o{ complaint
app_user ||--o{ banned_word : "веде"
app_user ||--o{ author_rating
advert ||--o{ author_rating
app_user ||--o{ organization_rating
organization ||--o{ organization_rating

note bottom of event
