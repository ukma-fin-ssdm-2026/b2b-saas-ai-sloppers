@startuml Lab3_Component_Diagram
title Community Events Service — діаграма компонентів (Lab 3)

left to right direction
skinparam shadowing false
skinparam nodesep 40
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam defaultFontSize 13
skinparam component {
  BackgroundColor<<semester>> #FFF8DC
  BackgroundColor<<data>> #E6F3FF
  BackgroundColor<<external>> #FFFFFF
  BackgroundColor<<future>> #F0F0F0
  BorderColor #333333
}

actor "Користувач" as User

rectangle "Семестр (клієнт–сервер)" {
  component "React Web Client" as Client <<semester>>

  rectangle "Community Events Service\n(наш мікросервіс домену)" {
    component "API Controllers\n(REST / JSON)" as Api <<semester>>
    component "Auth Module\nреєстрація, JWT, ролі" as Auth <<semester>>
    component "Organizations Module" as Orgs <<semester>>
    component "Events & Moderation" as Events <<semester>>
    component "Bulletin Board" as Board <<semester>>
    component "Scraper Worker\n(cron)" as Scraper <<semester>>
    component "Calendar Export\n.ics / Google link" as Cal <<semester>>
  }

  database "PostgreSQL" as DB <<data>>
}

cloud "Зовнішні (семестр)" {
  component "Instagram /\nWhatsApp" as Social <<external>>
  component "Google Calendar" as GCal <<external>>
}

cloud "SmartUkma (майбутнє)" {
  component "account-server\nAuthZ" as Account <<future>>
  component "ui-constructor" as UICtor <<future>>
}

User --> Client : UI

Client --> Api : REST + JWT

Api --> Auth : IAuth
Api --> Orgs : IOrganizations
Api --> Events : IEvents
Api --> Board : IBoard
Api --> Cal : ICalendar

Auth --> DB : SQL
Orgs --> DB : SQL
Events --> DB : SQL
Board --> DB : SQL
Scraper --> DB : SQL

Scraper --> Social : HTTP scrape
Events ..> Scraper : створює\nчернетки подій
Cal --> GCal : deep link / .ics

Account ..> Auth : майбутня\nзаміна AuthZ
UICtor ..> Client : майбутній\nрендер UI

legend right
  |= stereotype |= значення |
  | <<semester>> | реалізуємо зараз |
  | <<data>> | сховище |
  | <<external>> | зовнішні сервіси |
  | <<future>> | поза обсягом семестру |
endlegend

@enduml
