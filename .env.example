# Copy to .env and fill in. Never commit .env.

# --- Required for infra/helpers/up.sh ---
# GitHub login of the token owner
GHCR_USERNAME=
# PAT (classic) with the read:packages scope only, shared within the team:
# https://github.com/settings/tokens/new?scopes=read:packages
GHCR_TOKEN=
# personal: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# openssl rand -base64 48
AUTH_JWT_SECRET=

# --- Optional for the backend ---
AUTH_ADMIN_EMAILS=
MAIL_FROM=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- docker-compose only: in Minikube CloudNativePG generates the database credentials ---
DB_URL=
DB_USER=
DB_PASSWORD=
